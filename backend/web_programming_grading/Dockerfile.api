FROM eclipse-temurin:21-jdk-alpine AS builder
WORKDIR /build
COPY mvnw .
COPY .mvn .mvn
COPY pom.xml .
COPY web_programming_grading_core/pom.xml web_programming_grading_core/
COPY web_programming_grading_api/pom.xml web_programming_grading_api/
COPY web_programming_grading_executor/pom.xml web_programming_grading_executor/
RUN --mount=type=cache,target=/root/.m2 ./mvnw dependency:go-offline -pl web_programming_grading_api -am -B
COPY . .
RUN --mount=type=cache,target=/root/.m2 ./mvnw clean package -pl web_programming_grading_api -am -DskipTests -B

FROM eclipse-temurin:21-jre-alpine
WORKDIR /app
COPY --from=builder /build/web_programming_grading_api/target/*.jar app.jar
EXPOSE 8080
ENTRYPOINT ["java", "-jar", "app.jar"]
